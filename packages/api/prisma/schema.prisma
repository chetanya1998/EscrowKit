generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Escrow {
  id                 String      @id @default(uuid())
  address            String      @unique
  payer              String
  payee              String
  arbiter            String?
  arbitrationAdapter String?
  factoryAddress     String
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  milestones         Milestone[]
  events             Event[]
  disputes           Dispute[]
}

model Milestone {
  id              String   @id @default(uuid())
  escrowAddress   String
  escrow          Escrow   @relation(fields: [escrowAddress], references: [address])
  index           Int
  amount          String   // Store as string to handle big numbers/decimals
  description     String
  deadline        DateTime?
  status          String   // PENDING, SUBMITTED, APPROVED, RELEASED, REFUNDED, DISPUTED
  deliverableHash String?
  disputeId       String?
  conditionHash   String?
  isVerified      Boolean  @default(false)
  
  @@unique([escrowAddress, index])
}

model Event {
  id              String   @id @default(uuid())
  escrowAddress   String
  escrow          Escrow   @relation(fields: [escrowAddress], references: [address])
  eventName       String
  blockNumber     BigInt
  transactionHash String
  args            Json
  createdAt       DateTime @default(now())
  
  @@index([escrowAddress])
}

model Dispute {
  id              String   @id @default(uuid())
  escrowAddress   String
  escrow          Escrow   @relation(fields: [escrowAddress], references: [address])
  milestoneIndex  Int
  disputeIdOnChain String
  status          String   // OPEN, RESOLVED
  reason          String?
  createdAt       DateTime @default(now())
}

model User {
  id              String   @id @default(uuid())
  address         String?  @unique
  username        String?  @unique
  email           String?  @unique
  passwordHash    String?
  googleId        String?  @unique
  authProvider    String   @default("local") // "local" | "google" | "wallet"
  bio             String?
  avatar          String?
  preferences     Json?    // { theme: 'dark', notifications: { email: true, app: true } }
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  apiKeys         ApiKey[]
}

model ApiKey {
  id        String   @id @default(uuid())
  key       String   @unique
  owner     User     @relation(fields: [ownerId], references: [id])
  ownerId   String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Webhook {
  id        String   @id @default(uuid())
  url       String
  secret    String
  events    String[]
  ownerId   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model MilestoneDraft {
  id            String   @id @default(uuid())
  escrowAddress String
  index         Int?
  title         String
  description   String
  amount        String
  deadline      DateTime
  creator       String
  isSigned      Boolean  @default(false)
  signature     String?
  status        String   // PENDING, SIGNED, REJECTED, COMMITTED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
